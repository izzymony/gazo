# ============================================
# VIBAAR WEB (BUYER FRONTEND) ENVIRONMENT CONFIG
# ============================================
# Copy to `.env.local` (git-ignored) and adjust for your environment.
# The tracked counterpart of the deploy values is in docs/DEPLOY.md;
# per-variable preflight checks live in docs/ENV-PREFLIGHT.md.
#
# There is deliberately NO localhost fallback in app code. A hardcoded default
# would let a production build ship without NEXT_PUBLIC_API_BASE_URL and quietly
# point every request at localhost:8088 — the auth flow would fail as a vague
# network error instead of a missing-config error. If this value is wrong, the
# build should say so.

# ============================================
# LOCAL DEVELOPMENT
# ============================================
# Must include /api/v1. The Go backend serves on 8088 (services/backend).
# Verified with: Get-NetTCPConnection -LocalPort 8088 -State Listen
NEXT_PUBLIC_API_BASE_URL=http://localhost:8088/api/v1

# ============================================
# PRODUCTION
# ============================================
# NEXT_PUBLIC_API_BASE_URL=https://api.vibaar.com/api/v1

# ============================================
# OPTIONAL
# ============================================
# Leave unset locally. NEXT_PUBLIC_* values are inlined at BUILD time, so
# changing them in Cloudflare requires a rebuild, not just a restart.
# NEXT_PUBLIC_SENTRY_DSN=
# NEXT_PUBLIC_GOOGLE_API_KEY=
# NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
# NEXT_PUBLIC_GA_MEASUREMENT_ID=
# NEXT_PUBLIC_ORDER_ON_SUCCESS=false
