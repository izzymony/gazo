# ============================================
# VIBAAR ADMIN PORTAL ENVIRONMENT CONFIG
# ============================================
# Copy this file to .env.local and configure according to your environment

# ============================================
# PRODUCTION ENVIRONMENT
# ============================================
# API Configuration
NEXT_PUBLIC_API_URL=https://api.vibaar.com
NEXT_PUBLIC_API_BASE_URL=https://api.vibaar.com/api/v1
NEXT_PUBLIC_ADMIN_API_URL=https://api.vibaar.com/api/v1/admin

# Admin Portal Configuration
NEXT_PUBLIC_ADMIN_PORTAL_URL=https://admin.vibaar.com
NEXT_PUBLIC_MAIN_PLATFORM_URL=https://vibaar.com

# Authentication Configuration
NEXTAUTH_SECRET=your-super-secure-admin-secret-key-production
NEXTAUTH_URL=https://admin.vibaar.com

# Environment
NEXT_PUBLIC_ENVIRONMENT=production
NEXT_PUBLIC_DEBUG_MODE=false

# Admin Session Configuration
ADMIN_SESSION_TIMEOUT=1800
ADMIN_MAX_SESSION_DURATION=28800
ADMIN_CONCURRENT_SESSIONS=1

# Security Configuration
ADMIN_MFA_REQUIRED=true
ADMIN_IP_WHITELIST_ENABLED=true
ADMIN_GEO_RESTRICTION_ENABLED=true
ADMIN_ALLOWED_IPS=your-office-ip-ranges
ADMIN_ALLOWED_COUNTRIES=NG

# External Services
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=your-google-maps-api-key

# ============================================
# MONITORING & LOGGING
# ============================================
# Application Monitoring
NEXT_PUBLIC_SENTRY_DSN=your-sentry-dsn-for-error-tracking
NEXT_PUBLIC_ANALYTICS_ID=your-analytics-id

# Logging Configuration
ADMIN_LOG_LEVEL=info
ADMIN_AUDIT_LOGGING=true
ADMIN_PERFORMANCE_MONITORING=true

# ============================================
# SECURITY KEYS
# ============================================
# JWT Configuration
JWT_ADMIN_SECRET=your-jwt-secret-for-admin-tokens
JWT_ADMIN_EXPIRATION=1h
JWT_ADMIN_REFRESH_EXPIRATION=7d

# Encryption Keys
ENCRYPTION_KEY=your-32-character-encryption-key
HASH_SALT=your-password-hash-salt

# ============================================
# INTEGRATION SETTINGS
# ============================================
# Email Configuration (for admin notifications)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=admin@vibaar.com
SMTP_PASSWORD=your-smtp-password
ADMIN_EMAIL_FROM=admin@vibaar.com

# Performance Settings
NEXT_PUBLIC_API_TIMEOUT=30000
ADMIN_DATA_REFRESH_INTERVAL=60000

# ============================================
# DEVELOPMENT NOTES
# ============================================
# For local development:
# 1. Copy this file to .env.local
# 2. Update API URLs to http://localhost:8088
# 3. Set DEBUG_MODE=true
# 4. Disable MFA and IP restrictions
# 5. Use local database URLs

# For staging:
# 1. Use staging API endpoints
# 2. Enable debug logging
# 3. Reduced security restrictions