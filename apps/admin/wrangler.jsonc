{
  // Cloudflare Worker config for the vibaar admin app, built with @opennextjs/cloudflare.
  // STAGING worker. Production admin would be a separate Worker (name vibaar-admin,
  // domain admin.vibaar.com) — keep them separate, never a runtime toggle.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "vibaar-admin-staging",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-08-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true
  },
  // Custom domain — wrangler provisions the DNS record + cert on the vibaar.com
  // zone during deploy (requires the zone on this Cloudflare account).
  "routes": [
    { "pattern": "admin-staging.vibaar.com", "custom_domain": true }
  ]
  // NEXT_PUBLIC_* are inlined at BUILD time — passed as env vars to `cf:deploy`.
  // See docs/CLOUDFLARE-STAGING.md.
}
