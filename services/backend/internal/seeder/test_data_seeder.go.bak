package seeder

import (
	"fmt"
	"log"
	"time"
	"insta-api/internal/core/domain"
	"insta-api/internal/database"
	"golang.org/x/crypto/bcrypt"
	"github.com/google/uuid"
)

// SeedTestData creates test data for local development
func SeedTestData() error {
	db := database.ConnectDB()
	
	log.Println("🌱 Starting test data seeding...")
	
	// Create test users
	users := []domain.User{
		{
			FirstName:    "Test",
			LastName:     "Vendor",
			Email:        "vendor@test.com",
			PhoneNumber:  "+1234567890",
			Role:         "vendor",
			IsActive:     true,
			IsVerified:   true,
		},
		{
			FirstName:    "Test",
			LastName:     "Customer",
			Email:        "customer@test.com",
			PhoneNumber:  "+1234567891",
			Role:         "customer",
			IsActive:     true,
			IsVerified:   true,
		},
		{
			FirstName:    "Test",
			LastName:     "Admin",
			Email:        "admin@test.com",
			PhoneNumber:  "+1234567892",
			Role:         "admin",
			IsActive:     true,
			IsVerified:   true,
		},
	}
	
	// Hash password for all users (password: "password123")
	hashedPassword, _ := bcrypt.GenerateFromPassword([]byte("password123"), bcrypt.DefaultCost)
	
	for i := range users {
		users[i].Password = string(hashedPassword)
		users[i].ID = uuid.New().String()
		
		if err := db.Create(&users[i]).Error; err != nil {
			log.Printf("User %s already exists or error: %v", users[i].Email, err)
		} else {
			log.Printf("✅ Created user: %s", users[i].Email)
		}
	}
	
	// Create test business for vendor
	vendorUser := users[0]
	business := domain.Business{
		ID:           uuid.New().String(),
		UserID:       vendorUser.ID,
		Name:         "Test Store",
		Description:  "A test store for local development",
		Category:     "Electronics",
		SubCategory:  "Mobile Phones",
		Email:        "store@test.com",
		PhoneNumber:  "+1234567890",
		Website:      "https://teststore.local",
		IsActive:     true,
		IsVerified:   true,
		StoreLogo:    "https://via.placeholder.com/200",
		StoreBanner:  "https://via.placeholder.com/800x200",
	}
	
	if err := db.Create(&business).Error; err != nil {
		log.Printf("Business already exists or error: %v", err)
	} else {
		log.Printf("✅ Created business: %s", business.Name)
	}
	
	// Create business address
	businessAddress := domain.BusinessAddress{
		ID:         uuid.New().String(),
		BusinessID: business.ID,
		Address:    "123 Test Street",
		City:       "Test City",
		State:      "Test State",
		Country:    "Test Country",
		ZipCode:    "12345",
		Latitude:   "0.0",
		Longitude:  "0.0",
	}
	
	if err := db.Create(&businessAddress).Error; err != nil {
		log.Printf("Business address already exists or error: %v", err)
	} else {
		log.Printf("✅ Created business address")
	}
	
	// Create test categories
	categories := []domain.Category{
		{ID: uuid.New().String(), Name: "Electronics", Description: "Electronic items", Icon: "📱"},
		{ID: uuid.New().String(), Name: "Fashion", Description: "Clothing and accessories", Icon: "👗"},
		{ID: uuid.New().String(), Name: "Home & Garden", Description: "Home improvement items", Icon: "🏠"},
		{ID: uuid.New().String(), Name: "Books", Description: "Books and stationery", Icon: "📚"},
		{ID: uuid.New().String(), Name: "Food & Drinks", Description: "Food and beverages", Icon: "🍔"},
	}
	
	for _, cat := range categories {
		if err := db.Create(&cat).Error; err != nil {
			log.Printf("Category %s already exists or error: %v", cat.Name, err)
		} else {
			log.Printf("✅ Created category: %s", cat.Name)
		}
	}
	
	// Create test products
	products := []domain.Product{
		{
			ID:          uuid.New().String(),
			BusinessID:  business.ID,
			Name:        "iPhone 13 Pro",
			Description: "Latest iPhone with amazing features",
			Price:       999.99,
			Stock:       10,
			CategoryID:  categories[0].ID,
			Images:      []string{"https://via.placeholder.com/400"},
			IsActive:    true,
			SKU:         "IPH13PRO",
			Weight:      0.5,
		},
		{
			ID:          uuid.New().String(),
			BusinessID:  business.ID,
			Name:        "Samsung Galaxy S21",
			Description: "Premium Android smartphone",
			Price:       899.99,
			Stock:       15,
			CategoryID:  categories[0].ID,
			Images:      []string{"https://via.placeholder.com/400"},
			IsActive:    true,
			SKU:         "SAMS21",
			Weight:      0.4,
		},
		{
			ID:          uuid.New().String(),
			BusinessID:  business.ID,
			Name:        "Designer T-Shirt",
			Description: "Comfortable cotton t-shirt",
			Price:       29.99,
			Stock:       50,
			CategoryID:  categories[1].ID,
			Images:      []string{"https://via.placeholder.com/400"},
			IsActive:    true,
			SKU:         "TSHIRT001",
			Weight:      0.2,
		},
		{
			ID:          uuid.New().String(),
			BusinessID:  business.ID,
			Name:        "Wireless Headphones",
			Description: "Noise-cancelling wireless headphones",
			Price:       199.99,
			Stock:       20,
			CategoryID:  categories[0].ID,
			Images:      []string{"https://via.placeholder.com/400"},
			IsActive:    true,
			SKU:         "WH001",
			Weight:      0.3,
		},
		{
			ID:          uuid.New().String(),
			BusinessID:  business.ID,
			Name:        "Coffee Maker",
			Description: "Automatic coffee maker with timer",
			Price:       79.99,
			Stock:       8,
			CategoryID:  categories[2].ID,
			Images:      []string{"https://via.placeholder.com/400"},
			IsActive:    true,
			SKU:         "CM001",
			Weight:      2.0,
		},
	}
	
	for _, product := range products {
		if err := db.Create(&product).Error; err != nil {
			log.Printf("Product %s already exists or error: %v", product.Name, err)
		} else {
			log.Printf("✅ Created product: %s", product.Name)
		}
	}
	
	// Create test wallet for vendor
	wallet := domain.Wallet{
		ID:              uuid.New().String(),
		UserID:          vendorUser.ID,
		Balance:         1000.00,
		PendingBalance:  500.00,
		Currency:        "USD",
		IsActive:        true,
	}
	
	if err := db.Create(&wallet).Error; err != nil {
		log.Printf("Wallet already exists or error: %v", err)
	} else {
		log.Printf("✅ Created wallet with balance: $%.2f", wallet.Balance)
	}
	
	// Create sample order
	order := domain.Order{
		ID:              uuid.New().String(),
		UserID:          users[1].ID, // Customer
		BusinessID:      business.ID,
		OrderNumber:     fmt.Sprintf("ORD-%d", time.Now().Unix()),
		TotalAmount:     129.98,
		Status:          "pending",
		PaymentStatus:   "pending",
		PaymentMethod:   "card",
		ShippingAddress: "123 Customer Street, Test City",
		Notes:           "Test order for local development",
	}
	
	if err := db.Create(&order).Error; err != nil {
		log.Printf("Order already exists or error: %v", err)
	} else {
		log.Printf("✅ Created test order: %s", order.OrderNumber)
	}
	
	// Create order items
	orderItems := []domain.OrderItem{
		{
			ID:        uuid.New().String(),
			OrderID:   order.ID,
			ProductID: products[2].ID, // T-Shirt
			Quantity:  2,
			Price:     29.99,
			Total:     59.98,
		},
		{
			ID:        uuid.New().String(),
			OrderID:   order.ID,
			ProductID: products[4].ID, // Coffee Maker
			Quantity:  1,
			Price:     79.99,
			Total:     79.99,
		},
	}
	
	for _, item := range orderItems {
		if err := db.Create(&item).Error; err != nil {
			log.Printf("Order item error: %v", err)
		}
	}
	
	log.Println("✅ Test data seeding completed!")
	log.Println("")
	log.Println("📝 Test Credentials:")
	log.Println("  Vendor:   vendor@test.com / password123")
	log.Println("  Customer: customer@test.com / password123")
	log.Println("  Admin:    admin@test.com / password123")
	log.Println("")
	log.Println("🔑 Default OTP for testing: 123456")
	
	return nil
}