PORT=3010

APP_NAME=insta-shop

DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=mysecretpassword
DB_DATABASE=postgres
DB_DEFAULT_CONFIG=charset=utf8mb4&parseTime=True&loc=Local

ENV=dev
SLEENGSHORT_KEY=
SLEENGSHORT_URL=


SMS_ID=Vibaar

INSTAGRAM_ID=
INSTAGRAM_SECRET=
INSTAGRAM_REDIRECT_URI=
INSTAGRAM_TOKEN=
# BVN encryption key (R8) — AES-256 for KYC BVN at-rest encryption.
# Generate: openssl rand -base64 32  (a base64 32-byte key, or a raw 32-char string)
BVN_ENCRYPTION_KEY=

# R5 — set to "true" to store KYC documents with Cloudinary AUTHENTICATED
# (private) delivery instead of public URLs. Requires authenticated delivery on
# the Cloudinary account. LAUNCH REQUIREMENT: enable + verify a KYC
# submit->admin-view round-trip on staging before go-live.
KYC_PRIVATE_STORAGE=false
