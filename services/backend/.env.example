# ============================================
# VIBAAR BACKEND - ENVIRONMENT TEMPLATE
# ============================================
# Copy to .env for local development. Never commit real credentials.
#
# GENERATED FROM CODE READS. Every variable below is one the backend actually
# calls os.Getenv on; nothing here is aspirational. The previous template had
# drifted badly — it omitted PAYSTACK_AUTH, PAYSTACK_URL, REFRESH_SECRET and
# both SHIPBUBBLE_API_KEY_* names, and listed 22 variables the code never reads
# (SMTP_*, CLOUDINARY_NAME/API_KEY/API_SECRET, SHIPBUBBLE_API_KEY,
# INSTAGRAM_ID/_SECRET, SENDCHAMP_API_KEY/_SENDER_NAME, TERMII_*, ...), so
# following it produced a backend that silently used none of them.
#
# [PROD-GUARD] = helper.ValidateEnv refuses to boot production if this is wrong.
# Real staging/production values live ONLY in the Render dashboard.
# See docs/ENV-PREFLIGHT.md for the full launch checklist.
# ============================================

# --- Application ---------------------------------------------------------
PORT=8088
APP_NAME=vibaar
APP_ENV=local                  # [PROD-GUARD] local|development|staging|production
ENV=local                      # [PROD-GUARD] must equal APP_ENV

# --- Auth secrets --------------------------------------------------------
JWT_SECRET=your-local-jwt-secret-change-in-production       # [PROD-GUARD]
REFRESH_SECRET=your-local-refresh-secret-change-in-prod     # [PROD-GUARD]

# --- Database ------------------------------------------------------------
# [PROD-GUARD] rejects localhost in production.
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=localpassword
DB_DATABASE=vibaar_local
DB_DRIVER=postgres
DB_DSN=postgres://postgres:localpassword@localhost:5432/vibaar_local?sslmode=disable

# --- CORS ----------------------------------------------------------------
# [PROD-GUARD] rejects localhost in production. Staging must include the
# staging origins — the built-in default list does NOT, so unset here means
# every staging browser call is CORS-blocked.
# staging: https://staging.vibaar.com,https://admin-staging.vibaar.com
# prod:    https://vibaar.com,https://www.vibaar.com,https://admin.vibaar.com
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- Payments (Paystack) -------------------------------------------------
# TWO VARIABLES, ONE SECRET — set both to the same sk_ key.
#   PAYSTACK_AUTH       : used by the API client to initialise charges
#   PAYSTACK_SECRET_KEY : used as the HMAC key to verify inbound webhooks
# Set only one and the other half fails — the webhook half fails SILENTLY.
# [PROD-GUARD] both required, and sk_test_ is rejected in production.
PAYSTACK_AUTH=sk_test_xxxxxxxxxxxxx
PAYSTACK_SECRET_KEY=sk_test_xxxxxxxxxxxxx
PAYSTACK_URL=https://api.paystack.co
# Webhook endpoint to register in the Paystack dashboard:
#   {API_BASE}/api/v1/webhook/paystack

# --- Shipping (Shipbubble) -----------------------------------------------
# The code reads _PROD first and falls back to _STAGING. Set only ONE per
# environment: if both are set the service uses _PROD while the webhook
# verifier picks by ENV, and the signatures stop matching.
SHIPBUBBLE_API_KEY_PROD=
SHIPBUBBLE_API_KEY_STAGING=
SHIPBUBBLE_API_URL=https://app.shipbubble.com/api/v1
# Webhook endpoint to register in the Shipbubble dashboard:
#   {API_BASE}/api/v1/webhook/shipbubble

# --- Media / KYC storage -------------------------------------------------
# One URL, not three separate CLOUDINARY_* parts.
CLOUDINARY_URL=cloudinary://key:secret@cloud_name    # [PROD-GUARD]
KYC_PRIVATE_STORAGE=true                             # [PROD-GUARD] must be true in prod
BVN_ENCRYPTION_KEY=                                  # [PROD-GUARD] 32-byte key, AES-GCM at rest
KYC_WITHDRAWAL_GATE_NGN=100000

# --- Email (SendGrid) ----------------------------------------------------
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=noreply@vibaar.com
SENDGRID_FROM_NAME=Vibaar

# --- SMS / WhatsApp ------------------------------------------------------
# THREE providers are wired. Pick ONE for production and provision only it.
SMS_ID=
# Twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=
MESSAGING_SERVICE_SID=
TWILIO_WHATSAPP_PHONE_NUMBER=
TWILIO_WHATSAPP_OTP_CONTENT_SID=
# Sendchamp
SENDCHAMP_PUBLIC_API_KEY=
SENDCHAMP_SENDER_ID=
# Sleengshort
SLEENGSHORT_KEY=
SLEENGSHORT_URL=
# Inbound WhatsApp webhook (fails closed outside local)
WHATSAPP_WEBHOOK_VERIFY_TOKEN=

# --- Notifications -------------------------------------------------------
TRANSACTIONAL_NOTIFICATIONS_ENABLED=false

# --- Monitoring ----------------------------------------------------------
SENTRY_DSN=

# --- Admin bootstrap -----------------------------------------------------
# Creates the first admin once; an existing admin is never modified.
ADMIN_BOOTSTRAP_EMAIL=
ADMIN_BOOTSTRAP_PASSWORD=          # >= 12 chars

# --- OAuth (deferred: no social auth at launch) --------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URL=
INSTAGRAM_CLIENT_ID=
INSTAGRAM_CLIENT_SECRET=
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=

# --- Local-only switches -------------------------------------------------
# [PROD-GUARD] all three are rejected in production.
ENABLE_MOCK_SERVICES=false
SKIP_SMS_VERIFICATION=false
USE_LOCAL_FILE_STORAGE=false
SEED_TEST_PASSWORD=
