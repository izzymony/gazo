# ============================================
# VIBAAR BACKEND - ENVIRONMENT TEMPLATE
# ============================================
# Copy this file to .env.local for local development
# Copy this file to .env.test for testing
# Never commit real credentials to git
# ============================================

# Application Settings
PORT=8088
APP_NAME=vibaar
APP_ENV=local
ENV=local
JWT_SECRET=your-local-jwt-secret-change-in-production

# Database Configuration
# For local development, use Docker PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=localpassword
DB_DATABASE=vibaar_local
DB_DRIVER=postgres
DB_DEFAULT_CONFIG=charset=utf8mb4&parseTime=True&loc=Local

# For local testing without SSL
# For production, add: &sslmode=require
DB_DSN=postgres://postgres:localpassword@localhost:5432/vibaar_local?sslmode=disable

# CORS Configuration
# For production: https://vibaar.com,https://www.vibaar.com,https://admin.vibaar.com
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# External Services (Use mock values for local)
# ============================================

# Payment Service - Paystack
PAYSTACK_SECRET_KEY=sk_test_xxxxxxxxxxxxx
PAYSTACK_PUBLIC_KEY=pk_test_xxxxxxxxxxxxx

# SMS Services
# NOTE: the *_SENDER_* values below are the sender name shown on every OTP/alert
# SMS a buyer or seller receives. They must be REGISTERED with each provider
# before they will send — an unregistered sender ID is silently rejected or
# rewritten by Nigerian carriers. Register "Vibaar" with Termii/Sendchamp as
# part of the launch secret rotation.
SMS_ID=Vibaar
TWILIO_ACCOUNT_SID=AC_test_xxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=test_xxxxxxxxxxxxx
TWILIO_PHONE_NUMBER=+1234567890

TERMII_API_KEY=test_termii_key
TERMII_SENDER_ID=Vibaar

SENDCHAMP_API_KEY=test_sendchamp_key
SENDCHAMP_SENDER_NAME=Vibaar

SLEENGSHORT_KEY=test_sleengshort_key
SLEENGSHORT_URL=http://localhost:8088/mock/sms

# File Upload - Cloudinary
CLOUDINARY_URL=cloudinary://test:test@test
CLOUDINARY_NAME=test-cloud
CLOUDINARY_API_KEY=test_api_key
CLOUDINARY_API_SECRET=test_api_secret

# Shipping Service - Shipbubble
SHIPBUBBLE_API_KEY=test_shipbubble_key
SHIPBUBBLE_API_URL=http://localhost:8088/mock/shipping

# Social Auth - Instagram
INSTAGRAM_ID=test_instagram_id
INSTAGRAM_SECRET=test_instagram_secret
INSTAGRAM_REDIRECT_URI=http://localhost:3000/auth/instagram/callback
INSTAGRAM_TOKEN=test_token

# Email Service (Optional)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
FROM_EMAIL=noreply@vibaar.com

# Sentry Error Tracking (get DSN from https://sentry.io)
SENTRY_DSN=

# Feature Flags (for local development)
ENABLE_MOCK_SERVICES=true
ENABLE_DEBUG_LOGGING=true
SKIP_SMS_VERIFICATION=true
SKIP_EMAIL_VERIFICATION=true
USE_LOCAL_FILE_STORAGE=true
# BVN encryption key (R8) — AES-256 for KYC BVN at-rest encryption.
# Generate: openssl rand -base64 32  (a base64 32-byte key, or a raw 32-char string)
BVN_ENCRYPTION_KEY=

# R5 — set to "true" to store KYC documents with Cloudinary AUTHENTICATED
# (private) delivery instead of public URLs. Requires authenticated delivery on
# the Cloudinary account. LAUNCH REQUIREMENT: enable + verify a KYC
# submit->admin-view round-trip on staging before go-live.
KYC_PRIVATE_STORAGE=false

# Admin bootstrap (used ONLY by `./backend seed`)
# There is no default admin any more — the seeder previously hardcoded a
# password that was published in this repo, and reset an existing admin's
# password to it on every run. Set these to create the FIRST admin; an existing
# admin is never modified. Password must be at least 12 characters.
ADMIN_BOOTSTRAP_EMAIL=
ADMIN_BOOTSTRAP_PASSWORD=

# Local-only test seeder (scripts/seed-realistic.go); refuses to run unless
# APP_ENV/ENV is local, dev or development.
SEED_TEST_PASSWORD=
