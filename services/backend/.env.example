# ============================================
# INSTASHOP BACKEND - ENVIRONMENT TEMPLATE
# ============================================
# Copy this file to .env.local for local development
# Copy this file to .env.test for testing
# Never commit real credentials to git
# ============================================

# Application Settings
PORT=8088
APP_NAME=insta-shop
APP_ENV=local
ENV=local
JWT_SECRET=your-local-jwt-secret-change-in-production

# Database Configuration
# For local development, use Docker PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=localpassword
DB_DATABASE=instashop_local
DB_DRIVER=postgres
DB_DEFAULT_CONFIG=charset=utf8mb4&parseTime=True&loc=Local

# For local testing without SSL
# For production, add: &sslmode=require
DB_DSN=postgres://postgres:localpassword@localhost:5432/instashop_local?sslmode=disable

# CORS Configuration
# For production, add wildcard subdomain support: https://*.getinstashop.co,https://*.myinstashop.co
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# External Services (Use mock values for local)
# ============================================

# Payment Service - Paystack
PAYSTACK_SECRET_KEY=sk_test_xxxxxxxxxxxxx
PAYSTACK_PUBLIC_KEY=pk_test_xxxxxxxxxxxxx

# SMS Services
SMS_ID=InstaShop-Dev
TWILIO_ACCOUNT_SID=AC_test_xxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=test_xxxxxxxxxxxxx
TWILIO_PHONE_NUMBER=+1234567890

TERMII_API_KEY=test_termii_key
TERMII_SENDER_ID=InstaShop

SENDCHAMP_API_KEY=test_sendchamp_key
SENDCHAMP_SENDER_NAME=InstaShop

SLEENGSHORT_KEY=test_sleengshort_key
SLEENGSHORT_URL=http://localhost:8088/mock/sms

# File Upload - Cloudinary
CLOUDINARY_URL=cloudinary://test:test@test
CLOUDINARY_NAME=test-cloud
CLOUDINARY_API_KEY=test_api_key
CLOUDINARY_API_SECRET=test_api_secret

# Shipping Service - Shipbubble
SHIPBUBBLE_API_KEY=test_shipbubble_key
SHIPBUBBLE_API_URL=http://localhost:8088/mock/shipping

# Social Auth - Instagram
INSTAGRAM_ID=test_instagram_id
INSTAGRAM_SECRET=test_instagram_secret
INSTAGRAM_REDIRECT_URI=http://localhost:3000/auth/instagram/callback
INSTAGRAM_TOKEN=test_token

# Email Service (Optional)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
FROM_EMAIL=noreply@instashop.local

# Sentry Error Tracking (get DSN from https://sentry.io)
SENTRY_DSN=

# Feature Flags (for local development)
ENABLE_MOCK_SERVICES=true
ENABLE_DEBUG_LOGGING=true
SKIP_SMS_VERIFICATION=true
SKIP_EMAIL_VERIFICATION=true
USE_LOCAL_FILE_STORAGE=true