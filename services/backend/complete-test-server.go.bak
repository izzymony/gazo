// CORS middleware
func enableCORS(w http.ResponseWriter) {
	w.Header().Set("Access-Control-Allow-Origin", "http://localhost:3001")
	w.Header().Set("Access-Control-Allow-Methods", "GET, POST, PUT, DELETE, OPTIONS, PATCH")
	w.Header().Set("Access-Control-Allow-Headers", "Content-Type, Authorization, Accept, Origin, Cache-Control, X-Requested-With")
	w.Header().Set("Access-Control-Allow-Credentials", "true")
	w.Header().Set("Access-Control-Max-Age", "86400")
}

func corsMiddleware(next http.HandlerFunc) http.HandlerFunc {
	return func(w http.ResponseWriter, r *http.Request) {
		enableCORS(w)
		
		if r.Method == "OPTIONS" {
			w.WriteHeader(http.StatusNoContent)
			return
		}
		
		next(w, r)
	}
}

// Health check
func healthHandler(w http.ResponseWriter, r *http.Request) {
	w.Header().Set("Content-Type", "application/json")
	json.NewEncoder(w).Encode(map[string]interface{}{
		"status":  "ok",
		"message": "Complete Test Server Running",
		"endpoints": []string{
			"POST /api/v1/validate-email-or-phone",
			"POST /api/v1/register",
			"POST /api/v1/login", 
			"GET  /api/v1/business",
			"GET  /api/v1/business/:id",
			"PUT  /api/v1/business/:id",
		},
	})
}

// Validate email or phone
func validateEmailOrPhoneHandler(w http.ResponseWriter, r *http.Request) {
	w.Header().Set("Content-Type", "application/json")
	
	// Parse the request body
	var req map[string]string
	json.NewDecoder(r.Body).Decode(&req)
	identifier := req["identifier"]
	
	// Check if user exists in test data
	userExists := false
	userType := "email"
	username := ""
	
	// Check against test user data
	if testUser.Email == identifier || testUser.Phone == identifier {
		userExists = true
		if strings.Contains(identifier, "@") {
			userType = "email"
		} else {
			userType = "phone"
		}
		username = testUser.UserName
	}
	
	response := map[string]interface{}{
		"success": true,
		"message": "Valid",
		"data": map[string]interface{}{
			"exists":    userExists,
			"available": !userExists, // available means can be used for new registration
			"type":      userType,
			"username":  username,
		},
	}
	
	json.NewEncoder(w).Encode(response)
}

// Register/Signup
func registerHandler(w http.ResponseWriter, r *http.Request) {
	w.Header().Set("Content-Type", "application/json")
	
	var signupReq SignupRequest
	if err := json.NewDecoder(r.Body).Decode(&signupReq); err != nil {
		w.WriteHeader(http.StatusBadRequest)
		json.NewEncoder(w).Encode(map[string]string{"error": "Invalid request body"})
		return
	}
	
	// Mock successful registration
	mockToken := "mock-access-token-" + fmt.Sprintf("%d", time.Now().Unix())
	mockRefreshToken := "mock-refresh-token-" + fmt.Sprintf("%d", time.Now().Unix())
	
	// Create user with business
	newUser := *testUser
	newUser.FirstName = signupReq.FirstName
	newUser.LastName = signupReq.LastName
	newUser.UserName = signupReq.UserName
	newUser.Email = signupReq.Email
	newUser.Phone = signupReq.Phone
	newUser.AuthType = signupReq.AuthType
	
	response := map[string]interface{}{
		"data": map[string]interface{}{
			"token":         mockToken,
			"access_token":  mockToken,
			"refresh_token": mockRefreshToken,
			"data":          newUser,
		},
	}
	
	json.NewEncoder(w).Encode(response)
}

