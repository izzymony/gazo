package main

import (
	"encoding/json"
	"fmt"
	"log"
	"net/http"
	"strings"
	"time"
)

// Test data structures
type User struct {
	ID        string `json:"id"`
	FirstName string `json:"firstname"`
	LastName  string `json:"lastname"`
	UserName  string `json:"user_name"`
	Email     string `json:"email"`
	Phone     string `json:"phone"`
	AuthType  string `json:"auth_type"`
	Business  *Business `json:"business"`
}

type Business struct {
	ID          string `json:"id"`
	Name        string `json:"name"`
	Tag         string `json:"tag"`
	Email       string `json:"email"`
	Phone       string `json:"phone"`
	UserID      string `json:"user_id"`
	Category    string `json:"category"`
	Description string `json:"description"`
	OrderCount  int    `json:"order_count"`
	CreatedAt   string `json:"created_at"`
	UpdatedAt   string `json:"updated_at"`
	Address     *Address `json:"address,omitempty"`
	BusinessSetting *BusinessSetting `json:"business_setting,omitempty"`
	BusinessBankAccountDetail *BankAccountDetail `json:"business_bank_account_detail,omitempty"`
}

type BankAccountDetail struct {
	ID         string `json:"id"`
	Account    string `json:"account"`
	Bank       string `json:"bank"`
	BusinessID string `json:"business_id"`
	Identifier string `json:"identifier"`
	CreatedAt  string `json:"created_at"`
	UpdatedAt  string `json:"updated_at"`
}

type Address struct {
	ID                      string `json:"id"`
	AddressLine             string `json:"address_line"`
	AddressLineTwo          string `json:"address_line_two"`
	Country                 string `json:"country"`
	Province                string `json:"province"`
	BusinessID              string `json:"business_id"`
	ShipbubbleAddressCode   int    `json:"shipbubble_address_code"`
	CreatedAt               string `json:"created_at"`
	UpdatedAt               string `json:"updated_at"`
}

type BusinessSetting struct {
	ID                      string `json:"id"`
	BusinessID              string `json:"business_id"`
	ShippingAmount          int    `json:"shipping_amount"`
	ShippingType            string `json:"shipping_type"`
	PersonalisedSettings    *PersonalisedSetting `json:"personalised_settings,omitempty"`
	CreatedAt               string `json:"created_at"`
	UpdatedAt               string `json:"updated_at"`
}

type PersonalisedSetting struct {
	ID               string `json:"id"`
	BackgroundColor  string `json:"background_color"`
	BackgroundImage  string `json:"background_image"`
	BackgroundState  string `json:"background_state"`
	CreatedAt        string `json:"created_at"`
	UpdatedAt        string `json:"updated_at"`
}

type LoginRequest struct {
	Identifier string `json:"identifier"`
	Password   string `json:"password"`
	AuthType   string `json:"auth_type"`
}

type SignupRequest struct {
	FirstName string `json:"firstname"`
	LastName  string `json:"lastname"`
	UserName  string `json:"user_name"`
	Email     string `json:"email"`
	Phone     string `json:"phone"`
	Password  string `json:"password"`
	AuthType  string `json:"auth_type"`
}

// Additional data structures for comprehensive API coverage
type Product struct {
	ID          string  `json:"id"`
	Name        string  `json:"name"`
	Description string  `json:"description"`
	Price       float64 `json:"price"`
	Category    string  `json:"category"`
	BusinessID  string  `json:"business_id"`
	ImageURL    string  `json:"image_url"`
	InStock     bool    `json:"in_stock"`
	Rating      float64 `json:"rating"`
	CreatedAt   string  `json:"created_at"`
}

type Order struct {
	ID         string    `json:"id"`
	UserID     string    `json:"user_id"`
	BusinessID string    `json:"business_id"`
	Products   []Product `json:"products"`
	Total      float64   `json:"total"`
	Status     string    `json:"status"`
	CreatedAt  string    `json:"created_at"`
}

type WalletBalance struct {
	Available float64 `json:"available"`
	Pending   float64 `json:"pending"`
	Total     float64 `json:"total"`
}

type Transaction struct {
	ID        string  `json:"id"`
	Amount    float64 `json:"amount"`
	Type      string  `json:"type"`
	Status    string  `json:"status"`
	CreatedAt string  `json:"created_at"`
}

type BankAccount struct {
	ID          string `json:"id"`
	BankName    string `json:"bank_name"`
	AccountName string `json:"account_name"`
	AccountNumber string `json:"account_number"`
}

type Analytics struct {
	TotalSales     float64 `json:"total_sales"`
	TotalOrders    int     `json:"total_orders"`
	TotalCustomers int     `json:"total_customers"`
	TotalProducts  int     `json:"total_products"`
}

// Dashboard Analytics structure matching frontend expectations
type DashboardAnalytics struct {
	Summary map[string]interface{} `json:"summary"`
	PercentChange map[string]interface{} `json:"percent_change"`
}

type ShippingProfile struct {
	ID      string `json:"id"`
	Name    string `json:"name"`
	Address string `json:"address"`
	Phone   string `json:"phone"`
	IsDefault bool `json:"is_default"`
}

// Vendor/Spotlight item structure for vendors page
type VendorItem struct {
	ID         string    `json:"id"`
	BusinessID string    `json:"business_id"`
	Business   *Business `json:"business"`
	Products   []Product `json:"products"`
	CreatedAt  string    `json:"created_at"`
	UpdatedAt  string    `json:"updated_at"`
}

