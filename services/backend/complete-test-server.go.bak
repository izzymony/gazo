}

// Router
func setupRoutes() {
	http.HandleFunc("/api/v1/healthcheck", corsMiddleware(healthHandler))
	http.HandleFunc("/api/v1/validate-email-or-phone", corsMiddleware(validateEmailOrPhoneHandler))
	http.HandleFunc("/api/v1/register", corsMiddleware(registerHandler))
	http.HandleFunc("/api/v1/login", corsMiddleware(loginHandler))
	
	// OTP endpoints
	http.HandleFunc("/api/v1/verification-code/send-register-otp", corsMiddleware(sendRegisterOtpHandler))
	http.HandleFunc("/api/v1/verification-code/validate-code", corsMiddleware(validateOtpHandler))
	http.HandleFunc("/api/v1/verification-code/send-withdrawal-request-otp", corsMiddleware(sendRegisterOtpHandler))
	
	// Business routes with method handling
	http.HandleFunc("/api/v1/business", corsMiddleware(func(w http.ResponseWriter, r *http.Request) {
		switch r.Method {
		case "GET":
			businessListHandler(w, r)
		case "POST":
			registerHandler(w, r) // Create business
		default:
			w.WriteHeader(http.StatusMethodNotAllowed)
		}
	}))
	
	http.HandleFunc("/api/v1/business/", corsMiddleware(func(w http.ResponseWriter, r *http.Request) {
		// Handle background theme endpoints
		if strings.Contains(r.URL.Path, "/background") {
			genericSuccessHandler(w, r)
			return
		}
		
		// Handle metrics endpoints
		if strings.Contains(r.URL.Path, "/metrics/") {
			dashboardAnalyticsHandler(w, r)
			return
		}
		
		// Handle regular business CRUD
		switch r.Method {
		case "GET":
			businessByIdHandler(w, r)
		case "PUT":
			updateBusinessHandler(w, r)
		default:
			w.WriteHeader(http.StatusMethodNotAllowed)
		}
	}))
	
	// Business Analytics & Dashboard
	http.HandleFunc("/api/v1/business/get-dashboard-analytics", corsMiddleware(dashboardAnalyticsHandler))
	http.HandleFunc("/api/v1/business/get-sales-analytics", corsMiddleware(salesAnalyticsHandler))
	http.HandleFunc("/api/v1/business/get-customer-analytics", corsMiddleware(customerAnalyticsHandler))
	http.HandleFunc("/api/v1/business/get-store-analytics/", corsMiddleware(salesAnalyticsHandler))
	http.HandleFunc("/api/v1/business/get-customers", corsMiddleware(businessCustomersHandler))
	http.HandleFunc("/api/v1/business/get-product-ranking", corsMiddleware(productsHandler))
	http.HandleFunc("/api/v1/business/get-activities", corsMiddleware(genericSuccessHandler))
	http.HandleFunc("/api/v1/business/mark-activity-read/", corsMiddleware(genericSuccessHandler))
	http.HandleFunc("/api/v1/business/get-all-products", corsMiddleware(productsHandler))
	http.HandleFunc("/api/v1/business/get-product/", corsMiddleware(productByIdHandler))
	http.HandleFunc("/api/v1/business/get-orders", corsMiddleware(businessOrdersHandler))
	http.HandleFunc("/api/v1/business/get-user-recently-viewed-businesses", corsMiddleware(recentlyViewedBusinessesHandler))
	http.HandleFunc("/api/v1/business/add-recently-viewed-businesses", corsMiddleware(genericSuccessHandler))
	http.HandleFunc("/api/v1/business/get-discounts", corsMiddleware(genericSuccessHandler))
	http.HandleFunc("/api/v1/business/create-discount", corsMiddleware(genericSuccessHandler))
	http.HandleFunc("/api/v1/business/get-bank-accounts", corsMiddleware(bankAccountsHandler))
	http.HandleFunc("/api/v1/business/add-bank-account", corsMiddleware(bankAccountsHandler))
	
	// Business Theme & Customization - handled by existing /api/v1/business/ route above
	
	// Product Management
	http.HandleFunc("/api/v1/products", corsMiddleware(productsHandler))
	http.HandleFunc("/api/v1/products/", corsMiddleware(productByIdHandler))
	http.HandleFunc("/api/v1/product/", corsMiddleware(func(w http.ResponseWriter, r *http.Request) {
		switch r.Method {
		case "PUT":
			productsHandler(w, r)
		default:
			productByIdHandler(w, r)
		}
	}))
	http.HandleFunc("/api/v1/products/rating", corsMiddleware(genericSuccessHandler))
	http.HandleFunc("/api/v1/products/get-user-wishlist", corsMiddleware(wishlistHandler))
	http.HandleFunc("/api/v1/products/add-wishlist/", corsMiddleware(wishlistHandler))
	
	// Categories & Collections
	http.HandleFunc("/api/v1/categories/get-all-categories", corsMiddleware(categoriesHandler))
	http.HandleFunc("/api/v1/collections/get-collections/", corsMiddleware(categoriesHandler))
	
	// Order Management
	http.HandleFunc("/api/v1/orders", corsMiddleware(ordersHandler))
	http.HandleFunc("/api/v1/orders/", corsMiddleware(ordersHandler))
	http.HandleFunc("/api/v1/orders/create-order", corsMiddleware(ordersHandler))
	http.HandleFunc("/api/v1/orders/get-user-orders", corsMiddleware(ordersHandler))
	http.HandleFunc("/api/v1/orders/get-order/", corsMiddleware(ordersHandler))
	
	// User Management
	http.HandleFunc("/api/v1/users", corsMiddleware(usersHandler))
	http.HandleFunc("/api/v1/users/", corsMiddleware(usersHandler))
	http.HandleFunc("/api/v1/users/update-user", corsMiddleware(usersHandler))
	http.HandleFunc("/api/v1/users/recommendations/", corsMiddleware(usersHandler))
	http.HandleFunc("/api/v1/users/follow-business/", corsMiddleware(genericSuccessHandler))
	http.HandleFunc("/api/v1/users/unfollow-business/", corsMiddleware(genericSuccessHandler))
	http.HandleFunc("/api/v1/users/get-following", corsMiddleware(businessListHandler))
	
	// Shipping & Address Management
	http.HandleFunc("/api/v1/shipping/add-shipping-profile", corsMiddleware(shippingProfilesHandler))
	http.HandleFunc("/api/v1/shipping-address/", corsMiddleware(shippingProfilesHandler))
	http.HandleFunc("/api/v1/shipping/get-user-shipping-profiles", corsMiddleware(shippingProfilesHandler))
	http.HandleFunc("/api/v1/shipping/get-shipping-options", corsMiddleware(shippingOptionsHandler))
	
	// Financial Management
	http.HandleFunc("/api/v1/wallet/get-wallet-balances", corsMiddleware(walletBalanceHandler))
	http.HandleFunc("/api/v1/wallet/get-wallet-transactions", corsMiddleware(walletTransactionsHandler))
	http.HandleFunc("/api/v1/wallet/withdraw", corsMiddleware(genericSuccessHandler))
	http.HandleFunc("/api/v1/bank/get-banks", corsMiddleware(bankAccountsHandler))
	http.HandleFunc("/api/v1/bank/validate-bank-account", corsMiddleware(genericSuccessHandler))
	
	// Payment & Transactions
	http.HandleFunc("/api/v1/transactions/initiate", corsMiddleware(genericSuccessHandler))
	http.HandleFunc("/api/v1/transactions/verify", corsMiddleware(genericSuccessHandler))
	
	// Authentication & Social
	http.HandleFunc("/api/v1/refresh-token", corsMiddleware(loginHandler))
	http.HandleFunc("/api/v1/forgot-password", corsMiddleware(genericSuccessHandler))
	http.HandleFunc("/api/v1/otp", corsMiddleware(sendRegisterOtpHandler))
	http.HandleFunc("/api/v1/auth/instagram", corsMiddleware(genericSuccessHandler))
	http.HandleFunc("/api/v1/auth/google", corsMiddleware(genericSuccessHandler))
	http.HandleFunc("/api/v1/auth/tiktok", corsMiddleware(genericSuccessHandler))
	http.HandleFunc("/api/v1/auth/callback", corsMiddleware(genericSuccessHandler))
}

func main() {
	setupRoutes()
	
	fmt.Println("🚀 COMPREHENSIVE InstaShop Test Server Starting on port 8088")
	fmt.Println("🔗 CORS configured for http://localhost:3001")
	fmt.Println("📊 Available endpoints (60+ endpoints):")
