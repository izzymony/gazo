# Do NOT shamefully-hoist: web and admin require DIFFERENT majors of shared deps
# (zustand v5 vs v4, sonner v2 vs v1, framer-motion v12 vs v11, tailwind-merge
# v3 vs v2). A flat hoist collapses each to one version and type-checks an app
# against the wrong one. pnpm's default per-app isolation gives each its own.
strict-peer-dependencies=false
auto-install-peers=true
