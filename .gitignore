# dependencies
node_modules/
.pnpm-store/

# builds / caches
.next/
out/
dist/
build/
.turbo/
*.tsbuildinfo

# Cloudflare / OpenNext build output
.open-next/
.wrangler/

# go (compiled binaries + runtime dirs live in services/backend)
services/backend/main
services/backend/insta-api
services/backend/vibaar-backend
services/backend/temp_build
services/backend/bin/
services/backend/tmp/
services/backend/uploads/
services/backend/logs/

# logs
*.log

# env / secrets — never commit real ones; templates are whitelisted below
.env
.env.*
!.env.example
!.env.sample

# os / editor
.DS_Store
coverage/

# database dumps — NEVER commit (PII + credential hashes). See the 2026-08-28
# history purge: a local pg_dump with 22 users + bcrypt hashes had to be removed
# from all history. Schema migrations are explicitly re-included below.
*.dump
*.sql.gz
*_backup_*.sql
backup_*.sql
*_schema.sql
pg_dump*.sql
!services/backend/migrations/**/*.sql
!services/backend/internal/migration/sql/*.sql
!services/backend/scripts/*.sql

# local-only design-system playground — NEVER committed, NEVER deployed.
# The route lives inside apps/web so it renders through the real Tailwind
# preset, globals.css tokens and @vibaar/ui components (a separate Storybook
# app would drift from what actually ships). apps/web/scripts/playground-guard.mjs
# parks it out of the tree for every build, asserts the output is clean, and
# CI asserts nothing under it is ever tracked. Ignore the WHOLE directory, not
# just the route file: a narrower rule would let a new fixture or helper beside
# it become trackable, which is the exact failure this guards against.
apps/web/src/app/(dev)/
apps/web/.playground-parked/

# drift audit report — regenerated on every run, never committed (the reviewed
# BASELINE at apps/web/design-drift-baseline.json is what is version-controlled)
apps/web/.drift/
