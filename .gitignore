# dependencies
node_modules/
.pnpm-store/

# builds / caches
.next/
out/
dist/
build/
.turbo/
*.tsbuildinfo

# go (compiled binaries + runtime dirs live in services/backend)
services/backend/main
services/backend/insta-api
services/backend/vibaar-backend
services/backend/temp_build
services/backend/bin/
services/backend/tmp/
services/backend/uploads/
services/backend/logs/

# logs
*.log

# env / secrets — never commit real ones; templates are whitelisted below
.env
.env.*
!.env.example
!.env.sample

# os / editor
.DS_Store
coverage/

# database dumps — NEVER commit (PII + credential hashes). See the 2026-08-28
# history purge: a local pg_dump with 22 users + bcrypt hashes had to be removed
# from all history. Schema migrations are explicitly re-included below.
*.dump
*.sql.gz
*_backup_*.sql
backup_*.sql
*_schema.sql
pg_dump*.sql
!services/backend/migrations/**/*.sql
!services/backend/internal/migration/sql/*.sql
!services/backend/scripts/*.sql
